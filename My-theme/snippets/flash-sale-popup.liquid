{% comment %} Only show on home page and if not dismissed within 24 hours {% endcomment %}
{%- if template == 'index' -%}
<style>
  /* --- Popup container --- */
  #flash-sale-popup {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999;
    transition: background-color 0.3s ease;
  }
  
  #flash-sale-popup.show {
    background: rgba(0,0,0,0.55);
  }
  
  /* Animation Options - Choose one by adding the class to .flash-box */
  
  /* 1. Bounce In (Playful) */
  @keyframes bounceIn {
    0% { transform: scale(0.3) translate(-50%, -50%); opacity: 0; }
    50% { transform: scale(1.05) translate(-50%, -50%); }
    70% { transform: scale(0.9) translate(-50%, -50%); }
    100% { transform: scale(1) translate(-50%, -50%); opacity: 1; }
  }
  
  /* 2. Slide Down (Elegant) */
  @keyframes slideDown {
    0% { transform: translateY(-100px) translate(-50%, -50%); opacity: 0; }
    100% { transform: translateY(0) translate(-50%, -50%); opacity: 1; }
  }
  
  /* 3. Zoom In (Modern) */
  @keyframes zoomIn {
    0% { transform: scale(0) translate(-50%, -50%); opacity: 0; }
    100% { transform: scale(1) translate(-50%, -50%); opacity: 1; }
  }
  
  /* 4. Rotate In (Creative) */
  @keyframes rotateIn {
    0% { transform: rotate(-200deg) scale(0) translate(-50%, -50%); opacity: 0; }
    100% { transform: rotate(0deg) scale(1) translate(-50%, -50%); opacity: 1; }
  }
  
  /* 5. Flip In (Dynamic) */
  @keyframes flipIn {
    0% { transform: perspective(400px) rotateY(90deg) translate(-50%, -50%); opacity: 0; }
    40% { transform: perspective(400px) rotateY(-20deg) translate(-50%, -50%); }
    60% { transform: perspective(400px) rotateY(10deg) translate(-50%, -50%); }
    80% { transform: perspective(400px) rotateY(-5deg) translate(-50%, -50%); }
    100% { transform: perspective(400px) rotateY(0deg) translate(-50%, -50%); opacity: 1; }
  }
  
  /* 6. Elastic In (Fun) */
  @keyframes elasticIn {
    0% { transform: scale(0) translate(-50%, -50%); opacity: 0; }
    55% { transform: scale(1.15) translate(-50%, -50%); opacity: 1; }
    75% { transform: scale(0.95) translate(-50%, -50%); }
    100% { transform: scale(1) translate(-50%, -50%); }
  }
  
  /* Exit animations */
  @keyframes fadeOut {
    from { opacity: 1; transform: scale(1) translate(-50%, -50%); }
    to { opacity: 0; transform: scale(0.8) translate(-50%, -50%); }
  }
  
  /* --- Box --- */
  .flash-box {
    background: {{ section.settings.bg_color | default: '#ffe8f0' }};
    color: {{ section.settings.text_color | default: '#4a2c40' }};
    border-radius: 12px;
    padding: 32px 40px;
    text-align: center;
    max-width: 340px;
    box-shadow: 0 8px 24px rgba(0,0,0,.15);
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    opacity: 0;
    
    /* Choose your animation style - uncomment ONE of these lines: */
    animation: bounceIn 0.6s ease forwards; /* Playful bounce */
     /*animation: slideDown 0.4s ease forwards; /* Elegant slide */
    /* animation: zoomIn 0.3s ease forwards; /* Modern zoom */
    /* animation: rotateIn 0.5s ease forwards; /* Creative rotate */
     /*animation: flipIn 0.6s ease forwards; /* Dynamic flip */
   /* animation: elasticIn 0.8s ease forwards; /* Fun elastic */
  }
  
  .flash-box.closing {
    animation: fadeOut 0.3s ease forwards;
  }
  
  /* --- Close button --- */
  .flash-close {
    position: absolute;
    top: 10px;
    right: 14px;
    font-size: 22px;
    cursor: pointer;
    line-height: 1;
    color: inherit;
    transition: opacity 0.2s ease;
  }
  
  .flash-close:hover {
    opacity: 0.7;
  }
</style>

<div id="flash-sale-popup">
  <div class="flash-box">
    <span class="flash-close" aria-label="Close">&times;</span>
    <h2 style="margin:0 0 8px;">Flash Sale</h2>
    <p style="margin:0 0 18px; font-size:1.2em;">
      <strong>30% OFF</strong><br>everything in store!
    </p>
    <a href="/collections/all" class="button button--primary">
      Shop Now
    </a>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const popup = document.getElementById('flash-sale-popup');
  const closeBtn = popup.querySelector('.flash-close');
  const STORAGE_KEY = 'flash_sale_dismissed';
  const ONE_DAY = 24 * 60 * 60 * 1000; // 24 hours in milliseconds
  
  // Check if popup should be shown
  function shouldShowPopup() {
    try {
      const dismissedData = localStorage.getItem(STORAGE_KEY);
      
      if (!dismissedData) {
        return true; // Never been dismissed
      }
      
      const dismissedTime = parseInt(dismissedData);
      const currentTime = new Date().getTime();
      
      // Show popup if more than 24 hours have passed
      return (currentTime - dismissedTime) > ONE_DAY;
      
    } catch (error) {
      console.log('LocalStorage not available, showing popup');
      return true;
    }
  }
  
  // Show popup if conditions are met
  if (shouldShowPopup()) {
    popup.style.display = 'flex';
    // Add show class with slight delay for smooth background transition
    setTimeout(() => {
      popup.classList.add('show');
    }, 10);
    console.log('Flash sale popup displayed');
  } else {
    console.log('Flash sale popup hidden - dismissed within last 24 hours');
  }
  
  // Handle close button click
  closeBtn.addEventListener('click', () => {
    const flashBox = popup.querySelector('.flash-box');
    flashBox.classList.add('closing');
    
    // Wait for exit animation to complete
    setTimeout(() => {
      popup.style.display = 'none';
      popup.classList.remove('show');
      flashBox.classList.remove('closing');
    }, 300);
    
    try {
      // Store current timestamp when dismissed
      const currentTime = new Date().getTime();
      localStorage.setItem(STORAGE_KEY, currentTime.toString());
      console.log('Flash sale popup dismissed and stored in localStorage');
    } catch (error) {
      console.log('Could not store dismissal in localStorage:', error);
    }
  });
  
  // Close popup when clicking outside the box
  popup.addEventListener('click', (e) => {
    if (e.target === popup) {
      closeBtn.click();
    }
  });
});
</script>
{%- endif -%}