{%- style -%}
  .field {
      margin: 10px 0px;
  }
  .field__input{
    background: {{ section.settings.input_field_background }};
    width: 100%;
    max-width: 400px;
  }
  button[type=submit]{
    background: {{ section.settings.button-background-color }};
    border-color: {{ section.settings.button-background-color }};
    color: {{ section.settings.button-text-color }};
  }
  .wishit-row{
    display: flex;
    flex-wrap: wrap;
  }
  .wishit-column {
    flex: 1;
    padding: 10px;
    box-sizing: border-box;
  }
  
  .wishit-column-image{
    background-image: url('{{ section.settings.image  | image_url: width: image_width, crop: 'center' }}');
    background-size: cover;
    background-position: center;
    min-height: 500px;
  }
  .wishit-column-form{
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wishit-column-form .field__label{
    display: none;
  }
  .newsletter-form-box{
    width: 80%;
    max-width: 800px;
    padding: 50px 10px;
  }
  .form__message{
    color: {{ section.settings.button-background-color }};
  }
  
  @media only screen and (max-width: 600px) {
    .wishit-column {
      flex: 100%;
    }
    .wishit-column-image{
      min-height: unset;
      height: 300px;
    }
    button[type=submit]{
      width: 100%;
    }
    .wishit-column-form{
      text-align: center;
      justify-content: center;
    }
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.95 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.95 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="wishit-row" style="background-color: {{ section.settings.background-color }}">
  {% if section.settings.image != blank %}
  <div class="wishit-column wishit-column-image" >
  </div>
  {% endif %}
  <div class="wishit-column wishit-column-form section-{{ section.id }}-padding">
    <div class="newsletter-form-box">
      {%- if section.settings.heading != blank -%}
        <h2 class="" style="font-size: {{ section.settings.heading_size }}px; margin: 0px;">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.tagline != blank -%}
        {{ section.settings.tagline }}
      {%- endif -%}
      {%- form 'customer', id: 'WishItNewsletterForm', class: 'isolate' -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message" tabindex="-1" autofocus>{{ section.settings.success_message }}</h2>
          {% if section.settings.redirect_url != blank %}
            <script>top.location.href="{{ section.settings.redirect_url }}";</script>
          {% endif %}
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body" role="alert" tabindex="-1" autofocus>{% render 'icon-error' %} {{ section.settings.success_message }}</h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
            <li>
              <a href="#ContactForm-email" class="link">
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </a>
            </li>
          </ul>
        {%- endif -%}
        <div class="contact__fields">
          <div class="field">
            <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact['Name']" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="Name">
            <label class="field__label" for="ContactForm-name">Name</label>
          </div>
          <div class="field field--with-error">
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="Email"
            >
            <label class="field__label" for="ContactForm-email">Email <span aria-hidden="true">*</span></label>
            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">Error</span>
                <span class="form__message">{% render 'icon-error' %} {{ form.errors.messages['email'] }}</span>
              </small>
            {%- endif -%}
          </div>
        </div>
        <div class="contact__button">
          <button type="submit" class="button">
            {{ section.settings.button_text }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "WishIt Newsletter Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Subscribe Now!",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "tagline",
      "default": "<p></p>",
      "label": "Tagline"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 14,
      "max": 100,
      "step": 2,
      "default": 36,
      "label": "Heading Size"
    },
    {
      "type": "color",
      "id": "background-color",
      "label": "Background Color"
    },{
        "type": "color",
        "id": "input_field_background",
        "label": "Input Background Color",
        "default": "#fefefe"
    },
    {
      "type": "text",
      "id": "button_text",
      "default": "SUBMIT",
      "label": "Button Text"
    },
    {
      "type": "text",
      "id": "success_message",
      "default": "Form Submitted Succesfully!",
      "label": "On Success Message"
    },
    {
      "type": "text",
      "id": "error_message",
      "default": "Something Went Wrong!",
      "label": "On Error Message"
    },
    {
      "type": "url",
      "id": "redirect_url",
      "label": "On Success Redirect"
    },
    {
      "type": "color",
      "id": "button-background-color",
      "default": "#444444",
      "label": "Button Background Color"
    },
    {
      "type": "color",
      "id": "button-text-color",
      "default": "#ffffff",
      "label": "Button Text Color"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "WishIt Newsletter Form"
    }
  ]
}
{% endschema %}
