{% style %}
:root {
--vtl-neutral-100: #222;
--vtl-neutral-70: #5e5e5e;
--vtl-neutral-01: #fff;
--vtl-alpha-black-10: rgba(34, 34, 34, 0.1);
--vtl-size-0: 0px;
--vtl-size-1: 1px;
--vtl-size-2: 2px;
--vtl-size-4: 4px;
--vtl-size-6: 6px;
--vtl-size-8: 8px;
--vtl-size-12: 12px;
--vtl-size-14: 14px;
--vtl-size-16: 16px;
--vtl-size-20: 20px;
--vtl-size-24: 24px;
--vtl-size-32: 32px;
--vtl-size-40: 40px;
--vtl-font-weight-400: 400;
--vtl-font-weight-600: 600;
--vtl-line-height-140: 1.4;
--vtl-text-decoration-none: none;
--vtl-text-decoration-underline: underline;
--vtl-text-decoration-line-through: line-through;
--vtl-border-width-1: var(--vtl-size-1);
--vtl-color-bg-fill-default-on-light: var(--vtl-neutral-100);
--vtl-color-bg-fill-inverse-on-light: var(--vtl-neutral-01);
--vtl-color-text-default-on-light: var(--vtl-neutral-100);
--vtl-color-text-disable-on-light: var(--vtl-neutral-70);
--vtl-color-text-on-bg-fill-on-light: var(--vtl-neutral-01);
--vtl-color-border-hover-on-dark: var(--vtl-alpha-black-10);
--vtl-space-0: var(--vtl-size-0);
--vtl-space-2: var(--vtl-size-2);
--vtl-space-4: var(--vtl-size-4);
--vtl-space-6: var(--vtl-size-6);
--vtl-space-8: var(--vtl-size-8);
--vtl-space-12: var(--vtl-size-12);
--vtl-space-16: var(--vtl-size-16);
--vtl-space-20: var(--vtl-size-20);
--vtl-space-24: var(--vtl-size-24);
--vtl-space-32: var(--vtl-size-32);
--vtl-space-40: var(--vtl-size-40);
--vtl-font-size-14: var(--vtl-size-14);
}


{% endstyle %}

<!-- --UUID-32557de6-- -->

<section class="Vtls-{{ section.id | handle }}">
	{%- capture card_has_bg_color -%}
		{%- case section.settings.product_card_background_color -%}
			{%- when '' or 'rgba(0,0,0,0)' -%}
				false
			{%- else -%}
				true
		{%- endcase -%}
	{%- endcapture -%}
	{%- capture card_has_border_color -%}
		{%- case section.settings.product_card_border_color -%}
			{%- when '' or 'rgba(0,0,0,0)' -%}
				false
			{%- else -%}
				true
		{%- endcase -%}
	{%- endcapture -%}

	{% for block in section.blocks %}
		{% case block.type %}
			{% when "heading" %}
				{% assign heading_block = block %}
			{% when "products" %}
				{% assign products_block = block %}
			{% when "banner" %}
				{% assign banner_block = block %}
		{% endcase %}
	{% endfor %}

	<div class="VtlsProductsGridBanner
						{% if section.settings.section_width == 100 %}VtlsProductsGridBanner--fullWidth{% endif %}">
		{%- if heading_block.settings.heading != blank -%}
			<h2
				class="
					VtlsProductsGridBanner__Heading
					VtlsProductsGridBanner__Heading--style-{{ heading_block.settings.heading_style }}
					VtlsProductsGridBanner__Heading--alignment-{{ heading_block.settings.heading_alignment }}
				"
				{{ heading_block.shopify_attributes }}
			>
				{{ heading_block.settings.heading }}
			</h2>
		{%- endif -%}
		<div class="VtlsProductsGridBanner__Content 
				VtlsProductsGridBanner__Content--bannerPlacement-{{ banner_block.settings.banner_placement }}">
			<div class="VtlsProductsGridBanner__Banner" {{ banner_block.shopify_attributes }}>
				<div class="VtlsProductsGridBannerImage">
					{%- if banner_block.settings.banner_image != blank -%}
						<div class="VtlsProductsGridBannerImage__ImageContainer">
							{{-
								banner_block.settings.banner_image
								| image_url: width: section.settings.image_desktop.width
								| image_tag:
									sizes: "100vw",
									widths: "400, 600, 800, 1200, 1600, 1800, 2400, 2800, 3200",
									fetchpriority: "low",
									loading: "lazy",
									class: "VtlsProductsGridBannerImage__Image"
							-}}
						</div>
					{%- else -%}
						<img
							src="data:image/webp;base64,"
							alt="Image with an abstract figure"
							width="580"
							height="580"
							loading="lazy"
							sizes="100vw"
							fetchpriority="low"
							class="VtlsProductsGridBannerImage__Image"
						>
					{%- endif -%}
				</div>
				<div
					class="
						VtlsProductsGridBannerTextContent
						VtlsProductsGridBannerTextContent--desktopPosition-{{ banner_block.settings.desktop_content_position }}
						VtlsProductsGridBannerTextContent--mobilePosition-{{ banner_block.settings.mobile_content_position }}
						{% if products_block.settings.product_list.count <= 3 and section.settings.image_aspect_ratio == 'landscape' %}VtlsProductsGridBannerTextContent--smallPadding{% endif %}
					"
				>
					{%- if banner_block.settings.banner_heading != blank -%}
						<h2 class="VtlsProductsGridBannerTextContent__Heading VtlsProductsGridBannerTextContent__Heading--style-{{ banner_block.settings.banner_heading_style }}">
							{{ banner_block.settings.banner_heading }}
						</h2>
					{%- endif -%}
					{%- if banner_block.settings.banner_description != blank -%}
						<div class="VtlsProductsGridBannerTextContent__Description">
							{{ banner_block.settings.banner_description }}
						</div>
					{%- endif -%}
					{% if banner_block.settings.banner_button_label != blank %}
						<div class="VtlsProductsGridBannerTextContent__Button">
							<a
								class="VtlsProductsGridBannerTextContentButton VtlsProductsGridBannerTextContentButton--{{ banner_block.settings.banner_button_style }}"
								href="{{ banner_block.settings.banner_button_link | default: "#" }}"
							>
								{{- banner_block.settings.banner_button_label | escape -}}
							</a>
						</div>
					{% endif %}
				</div>
			</div>
			<div class="VtlsProductsGridBanner__Products" {{ products_block.shopify_attributes }}>
				{% if products_block.settings.product_list.count > 0 %}
					{% for product in products_block.settings.product_list %}
						<div
							class="
								VtlsProductsGridProdCard
								{% if card_has_border_color == 'true' %}VtlsProductsGridProdCard--hasBorder{% endif %}
								{% if card_has_bg_color == 'true' %}VtlsProductsGridProdCard--hasBackground{% endif %}"
							{%- if section.settings.show_second_image_on_hover and product.images[1] -%}
								onmouseover="this.querySelector('img').src = '{{ product.images[1].src | image_url }}'"
								onmouseout="this.querySelector('img').src = '{{ product.images[0].src | image_url }}'"
							{%- endif -%}
						>
							<div class="VtlsProductsGridProdCard__Container">
								<div class="VtlsProductsGridProdCardImageContainer 
										 VtlsProductsGridProdCardImageContainer--{{ section.settings.image_aspect_ratio }}
										 {% if section.settings.show_second_image_on_hover == false %}
											VtlsProductsGridProdCardImageContainer--defaultHover
										 {% endif %}">
									<a href="{{ product.url }}">
										<img
											src="{{ product.images[0].src | image_url }}"
											alt="{{ product.images[0].alt }}"
											width="100%"
											height="100%"
										>
									</a>
								</div>
								<div class="VtlsProductsGridProdCardTextContainer">
									{% if section.settings.show_vendor %}
										<div class="VtlsProductsGridProdCardTextContainer__Vendor">
											{{ product.vendor }}
										</div>
									{% endif %}
									<p
										class="VtlsProductsGridProdCardTextContainer__ProductTitle"
										title="{{ product.title }}"
									>
										<a href="{{ product.url }}">{{ product.title }}</a>
									</p>
									<div class="VtlsProductsGridProdCardTextContainer__Prices">
										{% if product.compare_at_price %}
											<span class="VtlsProductsGridProdCardInitialPrice">
												{{- product.compare_at_price | money -}}
											</span>
										{% endif %}
										<span class="VtlsProductsGridProdCardPrice {% if product.compare_at_price %}price-with-red{% endif %}">
											{{ product.price | money }}
										</span>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				{% endif %}

				{% comment %}  ***** This block is generated as sample to allow user changes until the products are added to the list ***** {% endcomment %}
				{% if products_block.settings.product_list.count == 0 %}
					{% for i in (1..6) %}
						<div
							class="
								VtlsProductsGridProdCard
								{% if card_has_border_color == 'true' %}VtlsProductsGridProdCard--hasBorder{% endif %}
								{% if card_has_bg_color == 'true' %}VtlsProductsGridProdCard--hasBackground{% endif %}
							"
							{%- if section.settings.show_second_image_on_hover and product.images[1] -%}
								onmouseover="this.querySelector('img').src = '{{ product.images[1].src | image_url }}'"
								onmouseout="this.querySelector('img').src = '{{ product.images[0].src | image_url }}'"
							{%- endif -%}
						>
							<div class="VtlsProductsGridProdCard__Container">
								<div class="VtlsProductsGridProdCardImageContainer VtlsProductsGridProdCardImageContainer--{{ section.settings.image_aspect_ratio }}">
									<a href="{{ product.url }}">
										<img
											src="data:image/webp;base64,"
											alt="Image with an abstract figure"
											width="580"
											height="580"
											loading="lazy"
											sizes="100vw"
											fetchpriority="low"
										>
									</a>
								</div>
								<div class="VtlsProductsGridProdCardTextContainer">
									{% if section.settings.show_vendor %}
										<div class="VtlsProductsGridProdCardTextContainer__Vendor">VENDOR</div>
									{% endif %}
									<p
										class="VtlsProductsGridProdCardTextContainer__ProductTitle"
										title="Product title"
									>
										<a href="{{ product.url }}">Product title</a>
									</p>
									<div class="VtlsProductsGridProdCardTextContainer__Prices">
										<span class="VtlsProductsGridProdCardPrice"> $270.00 </span>
									</div>
								</div>
							</div>
						</div>
					{% endfor %}
				{% endif %}
			</div>
		</div>
	</div>
</section>

{% schema %}
