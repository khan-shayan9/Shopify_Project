<!-- templates/customers/registry.liquid -->
<div class="page-width">
  <h1>My Gift Registries</h1>
  
  {% if customer %}
    <div id="registry-dashboard">
      <button onclick="showCreateForm()" style="background: #007cba; color: white; border: none; padding: 10px 20px; border-radius: 4px; margin-bottom: 20px;">
        Create New Registry
      </button>
      
      <div id="create-form" style="display: none; background: #f8f9fa; padding: 20px; margin-bottom: 20px; border-radius: 8px;">
        <h3>Create New Registry</h3>
        <input type="text" id="registry-name" placeholder="Registry name..." style="width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ddd;">
        <button onclick="createRegistry()" style="background: #28a745; color: white; border: none; padding: 8px 16px; border-radius: 4px; margin-right: 10px;">Create</button>
        <button onclick="hideCreateForm()" style="background: #6c757d; color: white; border: none; padding: 8px 16px; border-radius: 4px;">Cancel</button>
      </div>
      
      <div id="registries-list">
        <!-- Registries will load here -->
      </div>
    </div>
  {% else %}
    <p>Please <a href="/account/login">log in</a> to manage your gift registries.</p>
  {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', loadRegistries);

function showCreateForm() {
  document.getElementById('create-form').style.display = 'block';
}

function hideCreateForm() {
  document.getElementById('create-form').style.display = 'none';
  document.getElementById('registry-name').value = '';
}

async function createRegistry() {
  const name = document.getElementById('registry-name').value;
  if (!name) return;
  
  try {
    const response = await fetch('/apps/gift-registry/api/registry', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        name,
        customerId: {{ customer.id | json }},
        customerEmail: {{ customer.email | json }},
        customerName: {{ customer.name | json }}
      })
    });
    
    const data = await response.json();
    if (data.success) {
      hideCreateForm();
      loadRegistries();
    }
  } catch (error) {
    console.error('Failed to create registry:', error);
  }
}

async function loadRegistries() {
  try {
    const response = await fetch('/apps/gift-registry/api/customer/registries');
    const data = await response.json();
    
    const container = document.getElementById('registries-list');
    container.innerHTML = data.registries.map(registry => `
      <div style="border: 1px solid #ddd; padding: 20px; margin: 15px 0; border-radius: 8px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
          <h3>${registry.name}</h3>
          <div>
            <button onclick="copyShareLink('${registry.shareToken}')" style="background: #17a2b8; color: white; border: none; padding: 6px 12px; border-radius: 4px; margin-left: 5px;">Share Link</button>
            <button onclick="deleteRegistry('${registry.id}')" style="background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; margin-left: 5px;">Delete</button>
          </div>
        </div>
        
        <div style="display: grid; gap: 10px;">
          ${registry.items.map(item => `
            <div style="display: flex; gap: 15px; padding: 10px; background: #f8f9fa; border-radius: 4px;">
              ${item.imageUrl ? `<img src="${item.imageUrl}" alt="${item.productTitle}" style="width: 60px; height: 60px; object-fit: cover;">` : ''}
              <div style="flex: 1;">
                <strong>${item.productTitle}</strong>
                ${item.variantTitle ? `<br><small>${item.variantTitle}</small>` : ''}
                <br>$${item.price}
                ${item.fulfilled ? '<br><span style="color: #28a745;">✓ Purchased by ' + item.purchasedBy + '</span>' : ''}
              </div>
              <button onclick="removeItem('${item.id}')" style="background: #dc3545; color: white; border: none; padding: 4px 8px; border-radius: 4px; height: fit-content;">Remove</button>
            </div>
          `).join('')}
        </div>
        
        ${registry.items.length === 0 ? '<p style="color: #6c757d; font-style: italic;">No items in this registry yet.</p>' : ''}
      </div>
    `).join('');
  } catch (error) {
    console.error('Failed to load registries:', error);
  }
}

function copyShareLink(shareToken) {
  const url = `${window.location.origin}/registry/${shareToken}`;
  navigator.clipboard.writeText(url).then(() => {
    alert('Share link copied to clipboard!');
  });
}

async function deleteRegistry(registryId) {
  if (!confirm('Are you sure you want to delete this registry?')) return;
  
  try {
    const response = await fetch(`/apps/gift-registry/api/registry/${registryId}`, {
      method: 'DELETE'
    });
    
    if (response.ok) {
      loadRegistries();
    }
  } catch (error) {
    console.error('Failed to delete registry:', error);
  }
}

async function removeItem(itemId) {
  try {
    const response = await fetch('/apps/gift-registry/api/registry/items', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ itemId })
    });
    
    if (response.ok) {
      loadRegistries();
    }
  } catch (error) {
    console.error('Failed to remove item:', error);
  }
}
</script>